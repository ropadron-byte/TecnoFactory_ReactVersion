# URL del backend Spring Boot (sin barra final).
VITE_API_URL=http://localhost:8080

# Client ID de Google Cloud (el MISMO que GOOGLE_CLIENT_ID del backend).
# En Google Cloud Console agrega http://localhost:5173 como "Authorized JavaScript origin".
VITE_GOOGLE_CLIENT_ID=CAMBIAR_CON_TU_CLIENT_ID.apps.googleusercontent.com
